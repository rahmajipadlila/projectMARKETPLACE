  "item": [
    {
      "name": "1. GET Daftar Seluruh Produk",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "http://localhost/web-marketplace/api/produk.php",
          "protocol": "http",
          "host": ["localhost"],
          "path": ["web-marketplace", "api", "produk.php"]
        }
      }
    },
    {
      "name": "2. GET Detail Produk Berdasarkan ID (id=1)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "http://localhost/web-marketplace/api/produk.php?id=1",
          "protocol": "http",
          "host": ["localhost"],
          "path": ["web-marketplace", "api", "produk.php"],
          "query": [
            { "key": "id", "value": "1" }
          ]
        }
      }
    },

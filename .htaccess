# Matikan directory listing
Options -Indexes

DirectoryIndex index.php

# Lindungi file sensitif
<FilesMatch "\.(sql|md|log|ini|example\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
